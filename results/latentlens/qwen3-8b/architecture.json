 "checks": {
  "source_order": [
   {
    "fact": "Block is pre-norm: input_layernorm is applied before self_attn, and the residual is added after it",
    "verified": true,
    "evidence": [
     "residual = hidden_states",
     "hidden_states = self.input_layernorm(hidden_states)",
     "hidden_states, _ = self.self_attn(",
     "hidden_states = residual + hidden_states",
     "residual = hidden_states",
     "hidden_states = self.post_attention_layernorm(hidden_states)",
     "hidden_states = self.mlp(hidden_states)",
     "hidden_states = residual + hidden_states"
    ]
   },
   {
    "fact": "Second sub-layer: post_attention_layernorm, then MLP, then the second residual addition",
    "verified": true,
    "evidence": [
     "hidden_states = self.post_attention_layernorm(hidden_states)",
     "hidden_states = self.mlp(hidden_states)"
    ]
   },
   {
    "fact": "q_norm and k_norm are RMSNorms over head_dim (one head vector at a time), not over hidden_size",
    "verified": true,
    "evidence": [
     "self.q_norm = Qwen3RMSNorm(self.head_dim, eps=config.rms_norm_eps)  # unlike olmo, only on the head dim!",
     "self.k_norm = Qwen3RMSNorm(self.head_dim, eps=config.rms_norm_eps)  # thus post q_norm does not need reshape"
    ]
   },
   {
    "fact": "q_norm / k_norm are applied after the projection and reshape to heads, and before RoPE",
    "verified": true,
    "evidence": [
     "query_states = self.q_norm(self.q_proj(hidden_states).view(hidden_shape)).transpose(1, 2)",
     "key_states = self.k_norm(self.k_proj(hidden_states).view(hidden_shape)).transpose(1, 2)",
     "value_states = self.v_proj(hidden_states).view(hidden_shape).transpose(1, 2)",
     "query_states, key_states = apply_rotary_pos_emb(query_states, key_states, cos, sin)"
    ]
   },
   {
    "fact": "V is not normalized and not rotated",
    "verified": true,
    "evidence": [
     "value_states = self.v_proj(hidden_states).view(hidden_shape).transpose(1, 2)",
     "key_states, value_states = past_key_values.update(key_states, value_states, self.layer_idx)"
    ]
   },
   {
    "fact": "RoPE rotates Q and K only (applied inside attention, not added to the residual stream)",
    "verified": true,
    "evidence": [
     "query_states, key_states = apply_rotary_pos_emb(query_states, key_states, cos, sin)"
    ]
   },
   {
    "fact": "RoPE uses the rotate-half pairing (dimension i with i + head_dim/2), not interleaved pairs",
    "verified": true,
    "evidence": [
     "x1 = x[..., : x.shape[-1] // 2]",
     "x2 = x[..., x.shape[-1] // 2 :]",
     "return torch.cat((-x2, x1), dim=-1)"
    ]
   },
   {
    "fact": "Attention scores are scaled by head_dim ** -0.5",
    "verified": true,
    "evidence": [
     "self.scaling = self.head_dim**-0.5"
    ]
   },
   {
    "fact": "Grouped-query attention: K/V heads are shared by num_attention_heads // num_key_value_heads query heads",
    "verified": true,
    "evidence": [
     "self.num_key_value_groups = config.num_attention_heads // config.num_key_value_heads"
    ]
   },
   {
    "fact": "Attention is causal",
    "verified": true,
    "evidence": [
     "self.is_causal = True"
    ]
   },
   {
    "fact": "MLP is SwiGLU: down_proj(act(gate_proj(x)) * up_proj(x))",
    "verified": true,
    "evidence": [
     "down_proj = self.down_proj(self.act_fn(self.gate_proj(x)) * self.up_proj(x))",
     "return down_proj"
    ]
   },
   {
    "fact": "RMSNorm computes in float32: x * rsqrt(mean(x^2) + eps), then multiplies by a learned gain (no bias, no mean subtraction)",
    "verified": true,
    "evidence": [
     "hidden_states = hidden_states.to(torch.float32)",
     "variance = hidden_states.pow(2).mean(-1, keepdim=True)",
     "hidden_states = hidden_states * torch.rsqrt(variance + self.variance_epsilon)",
     "return self.weight * hidden_states.to(input_dtype)"
    ]
   },
   {
    "fact": "A final RMSNorm (model.norm) follows the last decoder layer",
    "verified": true,
    "evidence": [
     "hidden_states = self.norm(hidden_states)"
    ]
   }
  ],
